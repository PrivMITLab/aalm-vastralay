# ==============================================================================
# 💻 AALM VASTRALAY (आलम वस्त्रालय) — LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE
# ==============================================================================
# फ़ाइल: .env.development.example
# उपयोग: इसे कॉपी करके `.env.local` नाम से सेव करें (`cp .env.development.example .env.local`)
# उद्देश्य: अपने लोकल कंप्यूटर / लैपटॉप पर ऐप चलाने के लिए (`npm run dev`)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. डेटाबेस (Neon Serverless PostgreSQL — मुफ़्त 500MB)
# ------------------------------------------------------------------------------
# साइनअप: https://neon.tech -> Create Project 'aalm-vastralay' -> Region: Mumbai (ap-south-1)
# लोकल डेवलपमेंट के लिए आप डायरेक्ट या पूल्ड कोई भी कनेक्शन स्ट्रिंग इस्तेमाल कर सकते हैं:
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD_HERE@ep-sample-pooler.ap-south-1.aws.neon.tech/neondb?sslmode=require"

# लोकल में डायरेक्ट क्वेरी की अनुमति (डेवलपमेंट के लिए "true"):
ALLOW_DIRECT_DB="true"

# ------------------------------------------------------------------------------
# 2. कोर सिक्योरिटी सीक्रेट्स (Local Development Fallbacks)
# ------------------------------------------------------------------------------
# नया 64-अक्षर हेक्स सीक्रेट जनरेट करने के लिए टर्मिनल में चलाएं:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# सेशन व कुकी ऑथराइजेशन:
AUTH_SECRET="dev_auth_secret_64_characters_long_local_test_key_aalm_vastralay_2026"

# AES-256-GCM डेटा एन्क्रिप्शन:
ENCRYPTION_SECRET="dev_encryption_secret_64_characters_long_test_key_for_local_use_2026"

# Bot Shield Proof-of-Work साल्ट:
POW_SECRET="aalm_dev_pow_shield_local_secret_salt_2026"

# ------------------------------------------------------------------------------
# 3. लोकल सर्वर URL व नेटवर्क सेटिंग्स
# ------------------------------------------------------------------------------
# लोकल सर्वर का पता:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# लोकल HTTP पर कुकीज़ चलने दें ("false"):
COOKIE_SECURE="false"

# लोकल में प्रॉक्सी हेडर ट्रस्ट:
TRUST_PROXY="true"

# इमेज ऑप्टिमाइज़ेशन:
NEXT_PUBLIC_USE_WSRV="true"

# ------------------------------------------------------------------------------
# 4. सुपर एडमिन लॉगिन (Local First Boot Credentials)
# ------------------------------------------------------------------------------
# जब आप पहली बार localhost:3000 खोलेंगे या /api/bootstrap चलाएंगे:
ADMIN_EMAIL="admin@aalmvastralay.com"
ADMIN_PASSWORD="Admin@123"

# डेटाबेस बूटस्ट्रैप टोकन:
BOOTSTRAP_TOKEN="aalm_boot_9f7c2b4e8a1d6e3f5a0c7b9e2d4f6a8c"

# लोकल में डमी डेटा लोड होने दें ("false"):
SKIP_SEED="false"

# ------------------------------------------------------------------------------
# 5. डायनेमिक यूपीआई चेकआउट (Testing VPA)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_UPI_VPA="testmerchant@upi"
NEXT_PUBLIC_UPI_PAYEE_NAME="Aalm Vastralay (Dev Store)"

# ------------------------------------------------------------------------------
# 6. ईमेल व ओटीपी (Local Dev Mode)
# ------------------------------------------------------------------------------
# लोकल में बिना किसी ईमेल सेवा के भी कंसोल लॉग्स में OTP दिखता है।
# यदि आप Google Apps Script टेस्ट करना चाहें:
# GAS_EMAIL_URL="https://script.google.com/macros/s/AKfycb_YOUR_ID/exec"
# GAS_SECRET_TOKEN="aalm_gas_mail_secret_test"

# ------------------------------------------------------------------------------
# 7. मीडिया व इमेज स्टोरेज (Local Direct Fallbacks)
# ------------------------------------------------------------------------------
# लोकल में डिफ़ॉल्ट रूप से हाई-क्वालिटी SVG और वेब इमेजेस स्वतः काम करती हैं।
NEXT_PUBLIC_B2_WORKER_URL="https://b2-proxy.marketplace.workers.dev"

# ------------------------------------------------------------------------------
# 8. स्टोर ब्रांडिंग व सपोर्ट डिफॉल्ट्स (Plain Text Customization)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Aalm Vastralay (Dev)"
NEXT_PUBLIC_BRAND_TAGLINE="Royal Indian Wedding & Luxury Ethnic Wear"
NEXT_PUBLIC_SUPPORT_PHONE="+91 98765 43210"
NEXT_PUBLIC_SUPPORT_WHATSAPP="+91 98765 43210"
NEXT_PUBLIC_SUPPORT_EMAIL="dev@aalmvastralay.com"
NEXT_PUBLIC_STORE_ADDRESS="Main Market, Bihar, India"
NEXT_PUBLIC_STORE_GSTIN="10ABCDE1234F1Z5"
