# ==============================================================================
# 👑 AALM VASTRALAY — PRODUCTION GITIGNORE
# Comprehensive, Enterprise-Grade Exclusion Policy
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (CRITICAL: Never commit secrets)
# ------------------------------------------------------------------------------
.env
.env*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*credentials*.json
*service-account*.json
secrets.json

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ------------------------------------------------------------------------------
# 3. Next.js, Bundlers & Build Outputs
# ------------------------------------------------------------------------------
.next/
.open-next/
out/
build/
dist/
.vercel
.turbo/
.swc/

# ------------------------------------------------------------------------------
# 4. Cloudflare, Serverless & Edge Tooling
# ------------------------------------------------------------------------------
.wrangler/
wrangler.log
cloudflare-worker/wrangler-b2-proxy.toml
!cloudflare-worker/wrangler-b2-proxy.example.toml

# ------------------------------------------------------------------------------
# 5. User Uploads, Media & Local Databases
# ------------------------------------------------------------------------------
/public/uploads/
/uploads/
/storage/
/media/
/public/media/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.duckdb
*.duckdb.*
*.parquet
.duckdb/

# ------------------------------------------------------------------------------
# 6. TypeScript, Linter & Tool Caches
# ------------------------------------------------------------------------------
*.tsbuildinfo
next-env.d.ts
.eslintcache
.stylelintcache
.prettiercache

# ------------------------------------------------------------------------------
# 7. Testing, Coverage & Playwright Artifacts
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright-results/
*.lcov

# ------------------------------------------------------------------------------
# 8. Operating System Junk & Thumbnails
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 9. IDEs, Editors & Workspaces
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project
*.sublime-grunt

# ------------------------------------------------------------------------------
# 10. Backups, Patches, Logs & Scratch Files
# ------------------------------------------------------------------------------
.backup/
*.backup
*.bak
*.old
*~
*.orig
*.rej
*.tmp
*.temp
*.patch
*.diff
scratch/
tmp/
temp/
logs/
*.log
*.zip
*.tar.gz

