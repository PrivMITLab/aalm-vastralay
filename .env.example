# ==============================================================================
# 👑 AALM VASTRALAY (आलम वस्त्रालय) — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# नोट: यह केवल एक टेम्पलेट है। इसमें असली सीक्रेट्स न डालें।
# प्रोडक्शन में इन वेरिएबल्स को Vercel Dashboard -> Settings -> Environment Variables में डालें।
# लोकल पर इसे कॉपी करके .env.local नाम से सेव करें।

# ------------------------------------------------------------------------------
# 1. डेटाबेस (Neon Serverless PostgreSQL — अनिवार्य / MANDATORY)
# कहाँ से मिलेगा: https://neon.tech -> Project 'aalm-vastralay' -> Region: Mumbai (ap-south-1)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxxxx-pooler.ap-south-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. सुरक्षा व ऑथेंटिकेशन (Security & Encryption — अनिवार्य / MANDATORY)
# जनरेट करने का तरीका: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
AUTH_SECRET="your_64_character_hex_string_for_auth_secret_here"
ENCRYPTION_SECRET="your_64_character_hex_string_for_encryption_secret_here"
POW_SECRET="aalm_pow_shield_secret_key_change_in_production"

# ------------------------------------------------------------------------------
# 3. साइट यूआरएल व कुकी सुरक्षा (Domain & Cookies)
# ------------------------------------------------------------------------------
# Vercel प्रोडक्शन डोमेन या आपका कस्टम डोमेन (e.g. https://aalmvastralay.in)
NEXT_PUBLIC_SITE_URL="https://aalm-vastralay.vercel.app"
COOKIE_SECURE="true"
NEXT_PUBLIC_USE_WSRV="true"

# ------------------------------------------------------------------------------
# 4. सुपर एडमिन व डेटाबेस ऑटो-माइग्रेशन (Super Admin & Bootstrap)
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@aalmvastralay.com"
ADMIN_PASSWORD="YourStrongAdminPassword2026!"
BOOTSTRAP_TOKEN="aalm_boot_9f7c2b4e8a1d6e3f5a0c7b9e2d4f6a8c"
SKIP_SEED="true"

# ------------------------------------------------------------------------------
# 5. इमेज होस्टिंग (ImageKit — मुफ़्त 20GB CDN — वैकल्पिक / OPTIONAL)
# कहाँ से मिलेगा: https://imagekit.io -> Developer Options -> API Keys
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_IMAGEKIT_URL="https://ik.imagekit.io/your_account_id"
# NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_xxxxxx"
# IMAGEKIT_PRIVATE_KEY="private_xxxxxx"

# ------------------------------------------------------------------------------
# 6. ईमेल सेवा (Google Apps Script — 100% मुफ़्त बिना डोमेन के OTP — अनुशंसित / RECOMMENDED)
# कहाँ से मिलेगा: docs/GAS_EMAIL_GUIDE.md देखें
# ------------------------------------------------------------------------------
GAS_EMAIL_URL="https://script.google.com/macros/s/AKfycb_YOUR_SCRIPT_ID/exec"
GAS_SECRET_TOKEN="aalm_gas_mail_secret_9988224411"

# ------------------------------------------------------------------------------
# 7. कोरियर व ट्रैकिंग (Shiprocket / Delhivery — वैकल्पिक / OPTIONAL)
# ------------------------------------------------------------------------------
# SHIPROCKET_EMAIL="your_shiprocket_email"
# SHIPROCKET_PASSWORD="your_shiprocket_password"
# DELHIVERY_API_KEY="your_delhivery_api_key"

# ------------------------------------------------------------------------------
# 8. ब्रांड व व्हाइट-लेबल कस्टमाइज़ेशन (Open-Source White-Label Branding)
# कोई भी व्यक्ति अपना स्टोर नाम, मोबाइल, ईमेल, लोगो, पता और UPI VPA यहाँ बिना कोड बदले सेट कर सकता है:
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Aalm Vastralay"
