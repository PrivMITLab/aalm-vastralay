# ==============================================================================
# 👑 AALM VASTRALAY (आलम वस्त्रालय) — MASTER PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# ⚠️ सुरक्षा चेतावनी / SECURITY WARNING:
# 1. यह फ़ाइल एक टेम्पलेट (.env.example) है। इसमें कभी भी अपने असली सीक्रेट्स न लिखें।
# 2. लोकल डेवलपमेंट के लिए: इस फ़ाइल को कॉपी करके `.env.local` नाम से सेव करें।
# 3. प्रोडक्शन डिप्लॉयमेंट के लिए: इन सभी वैल्यूज को Vercel / Cloudflare Dashboard ->
#    Settings -> Environment Variables में जोड़ें।
# ==============================================================================

# ==============================================================================
# 1. डेटाबेस कॉन्फ़िगरेशन (Neon Serverless PostgreSQL — अनिवार्य / MANDATORY)
# ==============================================================================
# कहाँ से मिलेगा: https://neon.tech -> Sign up (Free) -> Create Project 'aalm-vastralay'
# अनुशंसित क्षेत्र (Region): Mumbai (ap-south-1) for lowest latency in India
# ⚠️ नोट: प्रोडक्शन में हमेशा 'Pooled' कनेक्शन स्ट्रिंग और `?sslmode=require` का उपयोग करें।
DATABASE_URL="postgresql://neondb_owner:YOUR_STRONG_PASSWORD@ep-sample-pooler.ap-south-1.aws.neon.tech/neondb?sslmode=require"

# प्रोडक्शन में डायरेक्ट नॉन-पूलर क्वेरीज़ को ब्लॉक करने के लिए:
ALLOW_DIRECT_DB="false"

# ==============================================================================
# 2. कोर क्रिप्टोग्राफ़िक सीक्रेट्स (Security & Encryption — अनिवार्य / MANDATORY)
# ==============================================================================
# हेक्स स्ट्रिंग जनरेट करने का आसान तरीका (टर्मिनल में रन करें):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# सेशन टोकन, JWT और कुकी वेरिफिकेशन के लिए (64-अक्षर हेक्स स्ट्रिंग):
AUTH_SECRET="your_64_character_hex_string_for_auth_secret_here"

# संवेदनशील डेटा (जैसे कूरियर क्रेडेंशियल्स) के लिए AES-256-GCM एन्क्रिप्शन की:
ENCRYPTION_SECRET="your_64_character_hex_string_for_encryption_secret_here"

# Click-to-Solve बॉट शील्ड (Proof of Work) सिंगल-यूज़ टोकन सिग्नेचर सीक्रेट:
POW_SECRET="aalm_pow_shield_secret_key_change_in_production"

# ==============================================================================
# 3. डोमेन, कुकी व नेटवर्क सुरक्षा (Domain & Proxy Settings — अनिवार्य / MANDATORY)
# ==============================================================================
# आपकी वेबसाइट का लाइव प्रोडक्शन URL (बिना ट्रेलिंग स्लैश / के):
NEXT_PUBLIC_SITE_URL="https://aalm-vastralay.vercel.app"

# क्या कुकीज़ केवल HTTPS पर ट्रांसमिट होनी चाहिए (प्रोडक्शन में हमेशा "true"):
COOKIE_SECURE="true"

# Vercel / Cloudflare रिवर्स प्रॉक्सी के पीछे क्लाइंट IP सही पहचानने के लिए:
TRUST_PROXY="true"

# क्या wsrv.nl के जरिए ऑटोमैटिक WebP/AVIF कंप्रेशन चालू रखना है ("true" / "false"):
NEXT_PUBLIC_USE_WSRV="true"

# ==============================================================================
# 4. सुपर एडमिन व डेटाबेस ऑटो-माइग्रेशन (Super Admin & Bootstrap)
# ==============================================================================
# पहली बार डेटाबेस इनिशियलाइज़ करते समय बनने वाला सुपर एडमिन ईमेल व पासवर्ड:
ADMIN_EMAIL="admin@aalmvastralay.com"
ADMIN_PASSWORD="YourStrongAdminPassword2026!"

# दूरस्थ (Remote) डेटाबेस ऑटो-माइग्रेशन / रीसेट एंडपॉइंट सुरक्षा टोकन:
BOOTSTRAP_TOKEN="aalm_boot_9f7c2b4e8a1d6e3f5a0c7b9e2d4f6a8c"

# प्रोडक्शन में गलती से दोबारा डमी डेटा सीड होने से रोकने के लिए ("true"):
SKIP_SEED="true"

# ==============================================================================
# 5. ₹0 गेटवे फीस डायनेमिक यूपीआई कॉमर्स (Dynamic UPI QR Code Checkout)
# ==============================================================================
# आपका मर्चेंट UPI VPA (जिसपर ग्राहक सीधे पेमेंट करेंगे — 0% ट्रांजैक्शन फीस):
NEXT_PUBLIC_UPI_VPA="merchant@upi"

# ग्राहक के UPI ऐप (PhonePe/GPay/Paytm) पर दिखने वाला स्टोर/व्यापारी का नाम:
NEXT_PUBLIC_UPI_PAYEE_NAME="Aalm Vastralay"

# ==============================================================================
# 6. ईमेल सेवा (OTP, पासवर्ड रिकवरी और ऑर्डर कन्फर्मेशन)
# ==============================================================================
# विकल्प A (अनुशंसित / RECOMMENDED): Google Apps Script Mailer (100% Free, बिना डोमेन के)
# सेटअप गाइड: docs/GAS_EMAIL_GUIDE.md देखें
GAS_WEBHOOK_URL="https://script.google.com/macros/s/AKfycb_YOUR_APPS_SCRIPT_ID_HERE/exec"
GAS_EMAIL_URL="https://script.google.com/macros/s/AKfycb_YOUR_APPS_SCRIPT_ID_HERE/exec"
GAS_SECRET_TOKEN="aalm_gas_mail_secret_9988224411"

# Better Auth Configuration:
BETTER_AUTH_SECRET="aalm-vastralay-auth-secret-key-32-characters-minimum-length"
BETTER_AUTH_URL="http://localhost:3000"

# विकल्प B (वैकल्पिक): कस्टम QuietMail API या SMTP प्रदाता:
# QUIETMAIL_API_URL="https://api.quietmail.io/v1/send"
# QUIETMAIL_API_KEY="qm_live_xxxxxxxxxxxxxxxx"
# EMAIL_FROM="Aalm Vastralay <noreply@aalmvastralay.in>"

# ==============================================================================
# 7. बैकब्लेज़ B2 प्राइवेट स्टोरेज + क्लाउडफ्लेयर वर्कर CDN (Media Storage)
# ==============================================================================
# 10GB फ्री B2 स्टोरेज + असीमित फ्री बैंडविड्थ सेटअप: docs/B2_WORKER_SETUP.md देखें
B2_KEY_ID="005xxxxxxxxxxxx0000000001"
B2_APP_KEY="K005xxxxxxxxxxxxxxxxxxxxxx"
B2_BUCKET_ID="xxxxxxxxxxxxxxxxxxxx"
B2_BUCKET_NAME="aalm-vastralay-media"

# क्लाउडफ्लेयर वर्कर CDN प्रॉक्सी URL (फाइल्स सर्व करने के लिए):
NEXT_PUBLIC_B2_WORKER_URL="https://b2-proxy.marketplace.workers.dev"

# (वैकल्पिक) बैकअप डायरेक्ट B2 डाउनलोड URL:
# NEXT_PUBLIC_B2_DIRECT_URL="https://f005.backblazeb2.com/file/aalm-vastralay-media"
# NEXT_PUBLIC_B2_BUCKET_NAME="aalm-vastralay-media"

# ==============================================================================
# 8. इमेजकिट सीडीएन (ImageKit CDN — वैकल्पिक / Alternative 20GB CDN)
# ==============================================================================
# कहाँ से मिलेगा: https://imagekit.io -> Developer Options -> API Keys
# NEXT_PUBLIC_IMAGEKIT_URL="https://ik.imagekit.io/your_account_id"
# NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_xxxxxx"
# IMAGEKIT_PRIVATE_KEY="private_xxxxxx"

# ==============================================================================
# 9. कूरियर व AWB लॉजिस्टिक्स इंटीग्रेशन (Shiprocket / Delhivery — वैकल्पिक)
# ==============================================================================
# Shiprocket API (शिपिंग लेबल्स, पिकअप और AWB ट्रैकिंग के लिए):
# SHIPROCKET_EMAIL="your_shiprocket_email@example.com"
# SHIPROCKET_PASSWORD="your_shiprocket_password"

# Delhivery Logistics API Key:
# DELHIVERY_API_KEY="your_delhivery_api_key_here"

# ==============================================================================
# 10. ब्रांड व स्टोर कस्टमाइज़ेशन (Open-Source White-Label Branding)
# ==============================================================================
# कोई भी व्यक्ति बिना कोड छुए अपना स्टोर नाम, पता, संपर्क और जीएसटी यहाँ से बदल सकता है:
NEXT_PUBLIC_APP_NAME="Aalm Vastralay"
NEXT_PUBLIC_BRAND_TAGLINE="Royal Indian Wedding & Luxury Ethnic Wear"
NEXT_PUBLIC_SUPPORT_PHONE="+91 98765 43210"
NEXT_PUBLIC_SUPPORT_WHATSAPP="+91 98765 43210"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
NEXT_PUBLIC_DEFAULT_LOGO_URL="/brand/logo.svg"

# भौतिक स्टोर का पता और पिनकोड (डिलीवरी टाइम कैलकुलेटर के लिए):
NEXT_PUBLIC_STORE_ADDRESS="Main Market, Kalyanipur"
NEXT_PUBLIC_STORE_CITY="Patna"
NEXT_PUBLIC_STORE_STATE="Bihar"
NEXT_PUBLIC_STORE_PINCODE="800001"

# वैधानिक GST टैक्स इनवॉइस (Statutory Tax Invoice) के लिए स्टोर का GSTIN:
NEXT_PUBLIC_STORE_GSTIN="10ABCDE1234F1Z5"

# ==============================================================================
# 11. एनालिटिक्स व थर्ड-पार्टी हुक्स (वैकल्पिक / Optional)
# ==============================================================================
# (वैकल्पिक) कस्टम एनालिटिक्स ट्रैकर स्क्रिप्ट URL:
# NEXT_PUBLIC_ANALYTICS_SCRIPT_URL="https://analytics.example.com/script.js"

# (वैकल्पिक) यदि आप Better Auth का उपयोग करते हैं:
# BETTER_AUTH_SECRET="your_64_character_hex_string_here"
# BETTER_AUTH_URL="https://aalm-vastralay.vercel.app"
