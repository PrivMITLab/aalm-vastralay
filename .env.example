# ---------- Database (Neon PostgreSQL – free 0.5 GB) ----------
# Local dev:  postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-south-1.aws.neon.tech/aalm_vastralay?sslmode=require"

# ---------- Auth ----------
# Built-in cookie sessions (works offline). Change this in production!
AUTH_SECRET="change-me-to-a-long-random-string"
POW_SECRET="optional-separate-secret-for-the-proof-of-work-shield"
COOKIE_SECURE="true"           # set "true" when served over HTTPS
# Clerk (50k MAU free) – optional, see README "Switching to Clerk"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ---------- Images: ImageKit (20 GB bandwidth + 3 GB storage) ----------
NEXT_PUBLIC_IMAGEKIT_URL=https://ik.imagekit.io/aalm-vastralay
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx
# wsrv.nl proxy for external http(s) images (free, fair use). Set "false" to disable.
NEXT_PUBLIC_USE_WSRV=true

# ---------- Cold storage: Backblaze B2 (10 GB) + Cloudflare Worker proxy ----------
B2_KEY_ID=xxx
B2_APP_KEY=xxx
B2_BUCKET_NAME=aalm-vastralay-cold-storage
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
NEXT_PUBLIC_B2_WORKER_URL=https://aalm-b2-proxy.your-subdomain.workers.dev

# ---------- Email: quiet-mail (unlimited transactional) ----------
QUIETMAIL_API_URL=https://api.quiet-mail.example/v1/send
QUIETMAIL_API_KEY=xxx
EMAIL_FROM="Aalm Vastralay <orders@aalmvastralay.in>"

# ---------- Analytics: Loglyuk (10k pageviews) / Plausible CE ----------
NEXT_PUBLIC_LOGLYUK_DOMAIN=aalm-vastralay.pages.dev
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=https://loglyuk.com/js/script.js

# ---------- Monitoring & errors ----------
UPTIMEROBOT_API_KEY=xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@errex.your-server.com/1

# ---------- Site settings ----------
# Everything else (banner, grid, colours, currency, shipping, commissions, security limits,
# feature switches) lives in the `settings` table and is edited from /admin/settings.

# ---------- Misc ----------
SKIP_SEED=false                # "true" disables automatic demo-data seeding on boot
