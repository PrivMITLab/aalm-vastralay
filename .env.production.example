# ==============================================================================
# 🚀 AALM VASTRALAY (आलम वस्त्रालय) — LIVE PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# फ़ाइल: .env.production.example
# उपयोग: इन वेरिएबल्स को Vercel Dashboard -> Settings -> Environment Variables में डालें
# उद्देश्य: लाइव प्रोडक्शन वेबसाइट (`https://aalm-vastralay.vercel.app`) के लिए
# ==============================================================================

# ==============================================================================
# 🔴 1. अनिवार्य कोर वेरिएबल्स (MANDATORY TIER 1 — इनके बिना डिप्लॉय न करें)
# ==============================================================================

# डेटाबेस: Neon Serverless PostgreSQL (हमेशा 'Pooled' कनेक्शन स्ट्रिंग (-pooler) का उपयोग करें)
# कहाँ मिलेगा: https://neon.tech -> Project 'aalm-vastralay' -> Dashboard -> Connection Details (Pooled)
DATABASE_URL="postgresql://neondb_owner:YOUR_ACTUAL_NEON_PASSWORD@ep-sample-pooler.ap-south-1.aws.neon.tech/neondb?sslmode=require"

# प्रोडक्शन में बिना पूलर के डायरेक्ट कनेक्शन को ब्लॉक रखें ("false"):
ALLOW_DIRECT_DB="false"

# सुरक्षा: 64-अक्षर हेक्स स्ट्रिंग (टर्मिनल में रन करके जनरेट करें):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="PUT_A_NEW_64_CHAR_HEX_STRING_HERE_DO_NOT_SHARE"
ENCRYPTION_SECRET="PUT_A_SECOND_64_CHAR_HEX_STRING_HERE_FOR_AES_256"
POW_SECRET="aalm_pow_shield_production_salt_random_string_2026"

# प्रोडक्शन साइट URL (बिना ट्रेलिंग स्लैश / के):
NEXT_PUBLIC_SITE_URL="https://aalm-vastralay.vercel.app"

# कुकीज केवल HTTPS पर चलेंगी (हमेशा "true"):
COOKIE_SECURE="true"

# Vercel / Cloudflare IP प्रॉक्सी ट्रस्ट:
TRUST_PROXY="true"

# हाई-स्पीड WebP/AVIF CDN कंप्रेशन:
NEXT_PUBLIC_USE_WSRV="true"

# ==============================================================================
# 🟡 2. ₹0 फ्री टियर अनुशंसित वेरिएबल्स (RECOMMENDED TIER 2 — 100% Free)
# ==============================================================================

# सुपर एडमिन लॉगिन (प्रोडक्शन का असली एडमिन ईमेल व सुरक्षित पासवर्ड):
ADMIN_EMAIL="admin@aalmvastralay.com"
ADMIN_PASSWORD="YourSuperSecureAdminPassword2026!"

# डेटाबेस बूटस्ट्रैप / ऑटो-माइग्रेशन सीक्रेट टोकन:
BOOTSTRAP_TOKEN="aalm_boot_9f7c2b4e8a1d6e3f5a0c7b9e2d4f6a8c"

# प्रोडक्शन में डमी डेटा ओवरराइट ब्लॉक रखें:
SKIP_SEED="true"

# आपका मर्चेंट UPI VPA (ग्राहकों से सीधे बैंक खाते में भुगतान लेने के लिए — ₹0 फीस):
NEXT_PUBLIC_UPI_VPA="merchant@upi"
NEXT_PUBLIC_UPI_PAYEE_NAME="Aalm Vastralay"

# Google Apps Script मुफ़्त ईमेल रिले (गाइड: docs/GAS_EMAIL_GUIDE.md):
GAS_EMAIL_URL="https://script.google.com/macros/s/AKfycb_YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec"
GAS_SECRET_TOKEN="aalm_gas_mail_secret_secure_token_9988"

# बैकब्लेज़ B2 + क्लाउडफ्लेयर वर्कर CDN (गाइड: docs/b2-cloudflare-setup.md):
NEXT_PUBLIC_B2_WORKER_URL="https://b2-proxy.marketplace.workers.dev"

# ==============================================================================
# ⚪ 3. वैकल्पिक सेवाएं (OPTIONAL TIER 3 — शुरू में ज़रूरत नहीं)
# ==============================================================================

# शिपिंग ऑटोमेशन (Shiprocket):
# SHIPROCKET_EMAIL="your_email@example.com"
# SHIPROCKET_PASSWORD="your_password"

# डायरेक्ट एक्सप्रेस कूरियर (Delhivery):
# DELHIVERY_API_KEY="your_delhivery_production_token"

# वैकल्पिक पेड इमेज CDN (ImageKit — यदि B2 इस्तेमाल कर रहे हैं तो ज़रूरत नहीं):
# NEXT_PUBLIC_IMAGEKIT_URL="https://ik.imagekit.io/your_id"
# NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_xxxx"
# IMAGEKIT_PRIVATE_KEY="private_xxxx"

# ==============================================================================
# 🟢 4. स्टोर ब्रांडिंग व संपर्क जानकारी (BRAND CUSTOMIZATION)
# ==============================================================================
NEXT_PUBLIC_APP_NAME="Aalm Vastralay"
NEXT_PUBLIC_BRAND_TAGLINE="Royal Indian Wedding & Luxury Ethnic Wear"
NEXT_PUBLIC_SUPPORT_PHONE="+91 98765 43210"
NEXT_PUBLIC_SUPPORT_WHATSAPP="+91 98765 43210"
NEXT_PUBLIC_SUPPORT_EMAIL="support@aalmvastralay.com"
NEXT_PUBLIC_STORE_ADDRESS="Main Market, Bihar, India"
NEXT_PUBLIC_STORE_GSTIN="10ABCDE1234F1Z5"
